# Hite SMS bridge — copy to .env (gitignored) and fill in.
# The XMPP account that the JMP.chat number is attached to. JMP creates one for
# you during signup if you don't have one; otherwise any Jabber ID works.
XMPP_JID=you@example.im
XMPP_PASSWORD=
# Gateway that turns SMS into XMPP messages (JMP uses Cheogram).
SMS_GATEWAY=cheogram.com
# Your JMP number in E.164 — the same value goes into REPORT_SMS in app.js.
MY_NUMBER=+15551234567
# 1 = hand new reports to Claude Code automatically (sms-bridge/triage.sh). Off by
# default: each run spends tokens, and a human should decide to turn it on.
AUTO_TRIAGE=0
